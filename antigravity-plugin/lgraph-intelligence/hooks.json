{
  "lgraph-capsule-telemetry": {
    "enabled": false,
    "PostToolUse": [
      {
        "matcher": "read_file|view_file|edit_file|write_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "\"<PATH_TO_LGRAPH>/backend/venv/Scripts/python.exe\" \"<PATH_TO_LGRAPH>/scripts/lgraph_telemetry_hook.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
